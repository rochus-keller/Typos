let config : Config {
    .defines += [ "HAVE_CONFIG_H" ] # not used: "NO_DEBUG"
    if target_toolchain == `gcc {
        .lib_names += [ "m" "stdc++" ]
        .ldflags += "-shared-libgcc"
        .cflags_c += [ "-fno-strict-aliasing" "-fno-common" "-std=c99" ]
        .cflags_cc += [ "-std=c++11" "-pedantic-errors" ]
    }else if target_toolchain == `msvc {
        # nothing to do
    }else {
        error("target toolchain not supported")
    }
    if build_mode == `debug {
        .defines += "TYPOS_DEBUG"
    }
}

